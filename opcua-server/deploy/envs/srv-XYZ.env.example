# Copy and edit this file to configure different OPC UA servers to run

# Global configuration
MACHINE_ID=xyz

# OpenTelemetry configuration
OTEL_HOST=signoz-otel-collector
OTEL_PORT=4317
OTEL_SERVICE_NAME=gaia-opcua-servers
OTEL_DEPLOYMENT_ENVIRONMENT=development

# OPC UA configuration
OPCUA_ENDPOINT=opc.tcp://0.0.0.0:4840/freeopcua/server/