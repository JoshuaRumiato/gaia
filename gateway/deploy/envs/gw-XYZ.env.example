# Copy and edit this file to configure different gateways to run

# Global configuration
MACHINE_ID=xyz

# OpenTelemetry configuration
OTEL_HOST=signoz-otel-collector
OTEL_PORT=4317
OTEL_SERVICE_NAME=gaia-gateways
OTEL_DEPLOYMENT_ENVIRONMENT=development

# OPC UA configuration
OPCUA_HOST=srv-xyz
OPCUA_PORT=4840
OPCUA_USERNAME=
OPCUA_PASSWORD=
OPCUA_MONITORED_ITEMS=ns=2;s=Channel1.Device1.MachinePieceCounter|ns=2;s=Channel1.Device1.MachineRejectedPieces|ns=2;s=Channel1.Device1.LinePieceCounter

# Counter watchdog configuration
WATCHDOG_TIMEOUT_SECONDS=20
WATCHDOG_MIN_PIECES=1
WATCHDOG_LINE_COUNTER_NAME=LinePieceCounter
WATCHDOG_MACHINE_COUNTER_NAME=MachinePieceCounter

# MQTT configuration
MQTT_HOST=gaia-emqx
MQTT_PORT=1883
# Development topic; use prod/gaia/<machine_id>/ to match the persistence rule.
MQTT_TOPIC=prod/gaia/xyz/
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TRANSPORT=tcp
